<?xml version="1.0" encoding="utf-8"?>
<!--
   Что попадает в облачный бэкап и перенос на новое устройство (Android 12+).
   Заданы только include: всё остальное (SSH-ключи keys/, known_hosts, подключения
   с паролями, пароли архивов, кеши) не копируется. Ключи Keystore на другое
   устройство не переносятся, поэтому зашифрованные пароли там всё равно не прочитать.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/connections.json" />
        <!-- user_data.json хранит частые пароли архивов открытым текстом — не переносим. -->
        <exclude domain="file" path="datastore/user_data.json" />
        <include domain="file" path="iconpacks/" />
        <include domain="file" path="custom_icons/" />
    </device-transfer>
</data-extraction-rules>
